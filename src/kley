# Version: 1.2.0
# ===============================================================
#
# CHANGELOG v1.2.0:
#   + Desktop notifications via notify-send
#   + Auto-timeout: kley on <minutes> for auto-off
#   + kley cancel: cancel scheduled auto-off
#   + Improved status output with remaining time
#   + Cosmetic fixes (help alignment)
#   + Better cleanup on shell exit
#
# ===============================================================

set -e

# Config
readonly KLEY_VERSION="1.2.0"
readonly HOSTS_FILE="/etc/hosts"
readonly HOSTS_BACKUP="/etc/hosts.monster"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kley"
readonly STATE_FILE="$STATE_DIR/session"
readonly TIMEOUT_FILE="$STATE_DIR/timeout"
readonly TIMEOUT_PID_FILE="$STATE_DIR/timeout.pid"
readonly DB_URL="https://raw.githubusercontent.com/TheCookieGod64/kley-db/main/blocklist.txt"
readonly MARKER_START="# === KLEY BLOCKLIST START ==="
readonly MARKER_END="# === KLEY BLOCKLIST END ==="

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly MAGENTA='\033[0;35m'
readonly BOLD='\033[1m'
readonly RESET='\033[0m'

# ===============================================================
# HELPERS
# ===============================================================

_get_hostname() {
    if [ -r /etc/hostname ]; then
        cat /etc/hostname 2>/dev/null
    elif command -v hostnamectl &> /dev/null; then
        hostnamectl --static 2>/dev/null || echo "localhost"
    else
        echo "localhost"
    fi
}

_ensure_state_dir() {
    [ -d "$STATE_DIR" ] || mkdir -p "$STATE_DIR"
}

_has_notify() {
    command -v notify-send &> /dev/null
}

_notify() {
    # Usage: _notify <urgency> <icon> <title> <body> [timeout_ms]
    local urgency="$1"
    local icon="$2"
    local title="$3"
    local body="$4"
    local timeout="${5:-5000}"

    if _has_notify; then
        notify-send \
            -u "$urgency" \
            -i "$icon" \
            -t "$timeout" \
            -a "kley" \
            "$title" \
            "$body" 2>/dev/null || true
    fi
}

_format_duration() {
    # Usage: _format_duration <seconds>
    local total=$1
    local min=$((total / 60))
    local sec=$((total % 60))
    echo "${min}m ${sec}s"
}

_get_elapsed() {
    if [ -f "$STATE_FILE" ]; then
        local start_time now
        start_time=$(cat "$STATE_FILE" 2>/dev/null || echo "$(date +%s)")
        now=$(date +%s)
        echo $((now - start_time))
    else
        echo 0
    fi
}

_cancel_scheduled_timeout() {
    if [ -f "$TIMEOUT_PID_FILE" ]; then
        local pid
        pid=$(cat "$TIMEOUT_PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
        fi
        rm -f "$TIMEOUT_PID_FILE" "$TIMEOUT_FILE"
    fi
}

# ===============================================================
# TOGGLE COMMANDS
# ===============================================================

cmd_status() {
    if [ -f "$HOSTS_BACKUP" ]; then
        echo -e "${RED}🔓 KLEY MODE: ON${RESET} ${YELLOW}(adblock disabled)${RESET}"

        local elapsed
        elapsed=$(_get_elapsed)
        if [ "$elapsed" -gt 0 ]; then
            echo -e "${CYAN}⏱  Active for: $(_format_duration "$elapsed")${RESET}"
        fi

        # Show scheduled auto-off
        if [ -f "$TIMEOUT_FILE" ]; then
            local timeout_at now remaining
            timeout_at=$(cat "$TIMEOUT_FILE" 2>/dev/null || echo 0)
            now=$(date +%s)
            remaining=$((timeout_at - now))

            if [ "$remaining" -gt 0 ]; then
                echo -e "${MAGENTA}⏰ Auto-off in: $(_format_duration "$remaining")${RESET}"
            fi
        fi

        # Warning if too long
        local min=$((elapsed / 60))
        if [ "$min" -gt 10 ]; then
            echo -e "${RED}⚠  You have been unprotected for ${min} minutes!${RESET}"
            echo -e "${YELLOW}   Turn off with: ${BOLD}kley off${RESET}"
        fi
    else
        local lines
        lines=$(wc -l < "$HOSTS_FILE" 2>/dev/null || echo "?")
        echo -e "${GREEN}🔒 KLEY MODE: OFF${RESET} ${CYAN}(adblock active - ${lines} rules)${RESET}"
    fi
}

cmd_on() {
    if [ -f "$HOSTS_BACKUP" ]; then
        echo -e "${YELLOW}⚠  Kley mode is already ON!${RESET}"
        cmd_status
        return 1
    fi

    _ensure_state_dir
    echo -e "${BLUE}🔓 Activating kley mode (disabling adblock)...${RESET}"

    if ! sudo mv "$HOSTS_FILE" "$HOSTS_BACKUP"; then
        echo -e "${RED}❌ Failed to backup hosts file!${RESET}" >&2
        return 1
    fi

    local hn
    hn=$(_get_hostname)

    {
        echo "127.0.0.1	localhost"
        echo "::1		localhost"
        echo "127.0.1.1	${hn}"
    } | sudo tee "$HOSTS_FILE" > /dev/null

    date +%s > "$STATE_FILE"

    # Handle auto-timeout
    local timeout_min="$1"
    if [ -n "$timeout_min" ]; then
        # Validate it's a number
        if ! [[ "$timeout_min" =~ ^[0-9]+$ ]]; then
            echo -e "${YELLOW}⚠  Invalid timeout: '${timeout_min}' (must be a number in minutes)${RESET}"
            echo -e "${YELLOW}   Continuing without auto-timeout${RESET}"
        elif [ "$timeout_min" -lt 1 ]; then
            echo -e "${YELLOW}⚠  Timeout too short (< 1 min), ignoring${RESET}"
        elif [ "$timeout_min" -gt 120 ]; then
            echo -e "${YELLOW}⚠  Timeout too long (> 120 min), ignoring for safety${RESET}"
        else
            # Schedule auto-off
            local timeout_sec=$((timeout_min * 60))
            local timeout_at=$(($(date +%s) + timeout_sec))
            echo "$timeout_at" > "$TIMEOUT_FILE"

            # Background process to auto-turn-off
            (
                sleep "$timeout_sec"
                if [ -f "$HOSTS_BACKUP" ]; then
                    "$0" off --auto 2>/dev/null || true
                fi
            ) &
            local bg_pid=$!
            echo "$bg_pid" > "$TIMEOUT_PID_FILE"
            disown "$bg_pid" 2>/dev/null || true

            echo -e "${MAGENTA}⏰ Auto-off scheduled in ${timeout_min} minute(s)${RESET}"
        fi
    fi

    echo -e "${GREEN}✅ Adblock OFF - Go get your key!${RESET}"
    echo -e "${YELLOW}⚠  Don't forget: ${BOLD}kley off${RESET}${YELLOW} when done.${RESET}"

    # Desktop notification
    if [ -n "$timeout_min" ] && [[ "$timeout_min" =~ ^[0-9]+$ ]]; then
        _notify "critical" "security-low" "🔓 KLEY MODE: ON" \
            "Adblock disabled — auto-off in ${timeout_min} min" 5000
    else
        _notify "critical" "security-low" "🔓 KLEY MODE: ON" \
            "Adblock is DISABLED — remember to turn it off!" 5000
    fi
}

cmd_off() {
    local is_auto=false
    if [ "$1" = "--auto" ]; then
        is_auto=true
    fi

    if [ ! -f "$HOSTS_BACKUP" ]; then
        if [ "$is_auto" = false ]; then
            echo -e "${YELLOW}⚠  Kley mode is already OFF!${RESET}"
            cmd_status
        fi
        return 1
    fi

    echo -e "${BLUE}🔒 Restoring adblock...${RESET}"

    if ! sudo mv "$HOSTS_BACKUP" "$HOSTS_FILE"; then
        echo -e "${RED}❌ Failed to restore hosts backup!${RESET}" >&2
        return 1
    fi

    # Get elapsed time before cleanup
    local elapsed
    elapsed=$(_get_elapsed)

    # Cleanup state files
    rm -f "$STATE_FILE"
    _cancel_scheduled_timeout

    local lines
    lines=$(wc -l < "$HOSTS_FILE" 2>/dev/null || echo "?")

    echo -e "${GREEN}✅ Adblock back ON (${lines} rules active)${RESET}"

    if [ "$elapsed" -gt 0 ]; then
        echo -e "${CYAN}⏱  Was active for: $(_format_duration "$elapsed")${RESET}"
    fi

    # Desktop notification
    if [ "$is_auto" = true ]; then
        _notify "normal" "security-high" "🔒 KLEY MODE: OFF" \
            "Auto-timeout: adblock restored (${lines} rules)" 4000
    else
        _notify "normal" "security-high" "🔒 KLEY MODE: OFF" \
            "Adblock restored (${lines} rules active)" 3000
    fi
}

cmd_toggle() {
    if [ -f "$HOSTS_BACKUP" ]; then
        cmd_off
    else
        cmd_on "$@"
    fi
}

cmd_cancel() {
    if [ ! -f "$TIMEOUT_FILE" ]; then
        echo -e "${YELLOW}⚠  No auto-off timer is scheduled.${RESET}"
        return 0
    fi

    _cancel_scheduled_timeout
    echo -e "${GREEN}✅ Auto-off timer cancelled.${RESET}"
    echo -e "${YELLOW}   Kley mode is still ON — turn off manually with: ${BOLD}kley off${RESET}"

    _notify "normal" "dialog-information" "⏰ Timer Cancelled" \
        "Auto-off cancelled — kley mode still ON" 3000
}

cmd_extend() {
    local extra_min="$1"

    if [ ! -f "$HOSTS_BACKUP" ]; then
        echo -e "${YELLOW}⚠  Kley mode is not active. Use 'kley on <minutes>' instead.${RESET}"
        return 1
    fi

    if [ -z "$extra_min" ] || ! [[ "$extra_min" =~ ^[0-9]+$ ]]; then
        echo -e "${RED}❌ Usage: kley extend <minutes>${RESET}"
        return 1
    fi

    # Cancel current timer
    _cancel_scheduled_timeout

    # Schedule new one
    local timeout_sec=$((extra_min * 60))
    local timeout_at=$(($(date +%s) + timeout_sec))
    echo "$timeout_at" > "$TIMEOUT_FILE"

    (
        sleep "$timeout_sec"
        if [ -f "$HOSTS_BACKUP" ]; then
            "$0" off --auto 2>/dev/null || true
        fi
    ) &
    local bg_pid=$!
    echo "$bg_pid" > "$TIMEOUT_PID_FILE"
    disown "$bg_pid" 2>/dev/null || true

    echo -e "${GREEN}✅ Auto-off rescheduled to ${extra_min} minute(s) from now${RESET}"
    _notify "normal" "dialog-information" "⏰ Timer Extended" \
        "Auto-off in ${extra_min} minute(s)" 3000
}

# ===============================================================
# DATABASE MANAGEMENT
# ===============================================================

cmd_install_db() {
    local source_url="${1:-$DB_URL}"
    local db_temp existing_temp new_temp
    db_temp=$(mktemp /tmp/kley-blocklist.XXXXXX)
    existing_temp=$(mktemp /tmp/kley-existing.XXXXXX)
    new_temp=$(mktemp /tmp/kley-new.XXXXXX)

    echo -e "${BLUE}📥 Downloading TheCookieGod64's blocklist database...${RESET}"

    if [[ "$source_url" == file://* ]]; then
        local local_path="${source_url#file://}"
        if [ ! -f "$local_path" ]; then
            echo -e "${RED}❌ Local database file not found:${RESET} $local_path" >&2
            rm -f "$db_temp" "$existing_temp" "$new_temp"
            return 1
        fi
        cp "$local_path" "$db_temp"
    elif [[ -f "$source_url" ]]; then
        cp "$source_url" "$db_temp"
    else
        if ! curl -fsSL "$source_url" -o "$db_temp"; then
            echo -e "${RED}❌ Failed to download database from:${RESET} $source_url" >&2
            rm -f "$db_temp" "$existing_temp" "$new_temp"
            return 1
        fi
    fi

    local total
    total=$(wc -l < "$db_temp")
    echo -e "${CYAN}📊 Source database contains ${total} blocklist rules.${RESET}"
    echo ""
    echo -e "${YELLOW}⚠  This will merge entries into ${HOSTS_FILE}.${RESET}"
    echo -e "${YELLOW}   Existing domains will NOT be duplicated.${RESET}"
    read -p "Do you want to proceed? [y/N]: " -n 1 -r || true
    echo ""

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Installation cancelled.${RESET}"
        rm -f "$db_temp" "$existing_temp" "$new_temp"
        return 0
    fi

    if [ -f "$HOSTS_BACKUP" ]; then
        echo -e "${RED}❌ Kley mode is currently active (adblock is OFF).${RESET}"
        echo -e "${YELLOW}Please run '${BOLD}kley off${RESET}${YELLOW}' first before modifying the database.${RESET}"
        rm -f "$db_temp" "$existing_temp" "$new_temp"
        return 1
    fi

    sudo cp "$HOSTS_FILE" "${HOSTS_FILE}.kley-backup-$(date +%s)"

    if grep -q "$MARKER_START" "$HOSTS_FILE"; then
        echo -e "${BLUE}🔄 Removing previous kley entries...${RESET}"
        sudo sed -i "/$MARKER_START/,/$MARKER_END/d" "$HOSTS_FILE"
    fi

    echo -e "${BLUE}🔍 Checking for duplicate domains...${RESET}"
    awk '/^[0-9]/ {print $2}' "$HOSTS_FILE" | sort -u > "$existing_temp"

    awk 'NR==FNR { existing[$1]=1; next } { if ($1 ~ /^[0-9]/ && !existing[$2]) print $1 " " $2 }' \
        "$existing_temp" "$db_temp" > "$new_temp"

    local new_count
    new_count=$(wc -l < "$new_temp" 2>/dev/null || echo 0)
    local skipped=$((total - new_count))

    if [ "$new_count" -eq 0 ]; then
        echo -e "${YELLOW}⚠  All entries already exist in ${HOSTS_FILE}. Nothing new to add!${RESET}"
        rm -f "$db_temp" "$existing_temp" "$new_temp"
        return 0
    fi

    echo -e "${BLUE}➕ Adding ${new_count} new entries (skipped ${skipped} duplicates)...${RESET}"

    {
        echo ""
        echo "$MARKER_START"
        echo "# Installed: $(date -u +'%Y-%m-%d %H:%M UTC')"
        echo "# Source: $source_url"
        echo "# Total entries: $new_count"
        cat "$new_temp"
        echo "$MARKER_END"
    } | sudo tee -a "$HOSTS_FILE" > /dev/null

    rm -f "$db_temp" "$existing_temp" "$new_temp"

    local total_hosts
    total_hosts=$(wc -l < "$HOSTS_FILE")
    echo -e "${GREEN}✅ Successfully installed ${new_count} rules!${RESET}"
    echo -e "${CYAN}📊 Total /etc/hosts lines: ${total_hosts}${RESET}"

    _notify "normal" "dialog-information" "📥 Blocklist Updated" \
        "Added ${new_count} new domains (${total_hosts} total)" 4000
}

cmd_remove_db() {
    if ! grep -q "$MARKER_START" "$HOSTS_FILE"; then
        echo -e "${YELLOW}⚠  No kley database entries found in ${HOSTS_FILE}.${RESET}"
        return 0
    fi

    local count
    count=$(sed -n "/$MARKER_START/,/$MARKER_END/p" "$HOSTS_FILE" | grep -c "^[0-9]" || echo 0)

    echo -e "${YELLOW}⚠  This will remove all ${count} kley entries from ${HOSTS_FILE}.${RESET}"
    read -p "Continue? [y/N]: " -n 1 -r || true
    echo ""

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Cancelled.${RESET}"
        return 0
    fi

    sudo cp "$HOSTS_FILE" "${HOSTS_FILE}.kley-pre-remove"
    sudo sed -i "/$MARKER_START/,/$MARKER_END/d" "$HOSTS_FILE"
    echo -e "${GREEN}✅ Successfully removed ${count} kley rules!${RESET}"
    echo -e "${CYAN}📊 Remaining /etc/hosts lines: $(wc -l < "$HOSTS_FILE")${RESET}"

    _notify "normal" "dialog-information" "🗑️ Blocklist Cleaned" \
        "Removed ${count} kley domains" 3000
}

cmd_db_info() {
    if ! grep -q "$MARKER_START" "$HOSTS_FILE"; then
        echo -e "${YELLOW}⚠  Kley database is NOT installed in ${HOSTS_FILE}.${RESET}"
        echo -e "Install with: ${BLUE}kley install-db${RESET}"
        return 0
    fi

    local count install_date source_info total_hosts
    count=$(sed -n "/$MARKER_START/,/$MARKER_END/p" "$HOSTS_FILE" | grep -c "^[0-9]" || echo 0)
    install_date=$(grep -A2 "$MARKER_START" "$HOSTS_FILE" | grep "Installed:" | sed 's/# Installed: //' || echo "Unknown")
    source_info=$(grep -A3 "$MARKER_START" "$HOSTS_FILE" | grep "Source:" | sed 's/# Source: //' || echo "Unknown")
    total_hosts=$(wc -l < "$HOSTS_FILE")

    echo -e "${BOLD}${BLUE}📊 KLEY Database Info${RESET}"
    echo -e "${CYAN}Installed on:${RESET}    ${install_date}"
    echo -e "${CYAN}Source:${RESET}          ${source_info}"
    echo -e "${CYAN}Kley rules:${RESET}      ${count}"
    echo -e "${CYAN}Total /etc/hosts:${RESET} ${total_hosts}"
}

# ===============================================================
# HELP & DISPATCHER
# ===============================================================

cmd_help() {
    echo -e "${BOLD}${BLUE}🔑 KLEY${RESET} - Adblock toggle & hosts manager for key-farming"
    echo -e "${CYAN}Version ${KLEY_VERSION} by TheCookieGod64${RESET}"
    echo ""
    echo -e "${BOLD}${YELLOW}USAGE:${RESET}"
    echo "    kley <command> [args]"
    echo ""
    echo -e "${BOLD}${YELLOW}ADBLOCK TOGGLE:${RESET}"
    echo -e "    ${GREEN}on${RESET} [minutes]      Disable adblock (with optional auto-off timer)"
    echo -e "    ${GREEN}off${RESET}               Restore adblock"
    echo -e "    ${GREEN}toggle${RESET}, t         Toggle between on/off"
    echo -e "    ${GREEN}status${RESET}, check     Show current adblock status"
    echo -e "    ${GREEN}cancel${RESET}            Cancel scheduled auto-off timer"
    echo -e "    ${GREEN}extend${RESET} <min>      Reschedule auto-off to X minutes from now"
    echo ""
    echo -e "${BOLD}${YELLOW}DATABASE COMMANDS:${RESET}"
    echo -e "    ${GREEN}install-db${RESET} [url]  Download and smart-merge community blocklist"
    echo -e "    ${GREEN}update-db${RESET}         Update the blocklist to latest version"
    echo -e "    ${GREEN}remove-db${RESET}         Remove only kley's entries from /etc/hosts"
    echo -e "    ${GREEN}db-info${RESET}           Show stats on installed blocklist entries"
    echo ""
    echo -e "${BOLD}${YELLOW}GENERAL:${RESET}"
    echo -e "    ${GREEN}version${RESET}, -v       Show version"
    echo -e "    ${GREEN}help${RESET}, -h          Show this help"
    echo ""
    echo -e "${BOLD}${YELLOW}EXAMPLES:${RESET}"
    echo "    kley on                # Disable adblock (manual off required)"
    echo "    kley on 5              # Disable adblock, auto-off in 5 minutes"
    echo "    kley extend 3          # Reschedule auto-off to 3 min from now"
    echo "    kley cancel            # Cancel auto-off (still ON, manual off needed)"
    echo "    kley off               # Re-enable adblock protection"
    echo "    kley toggle            # Switch state with one command"
    echo "    kley install-db        # Smart-merge community blocklist"
    echo ""
    echo -e "${BOLD}${YELLOW}NOTIFICATIONS:${RESET}"
    if _has_notify; then
        echo -e "    ${GREEN}✅ Desktop notifications enabled${RESET}"
    else
        echo -e "    ${YELLOW}⚠  notify-send not found — install libnotify for desktop popups${RESET}"
    fi
}

case "${1:-status}" in
    on|start|aan|onn)                    shift; cmd_on "$@" ;;
    off|stop|uit|oof)                    shift; cmd_off "$@" ;;
    status|check|stauts|"")              cmd_status ;;
    toggle|t|toggly|togly|toggel)        shift; cmd_toggle "$@" ;;
    cancel|abort|nocancel)               cmd_cancel ;;
    extend|reset-timer|reschedule)       shift; cmd_extend "$@" ;;
    install-db|installdb)                shift; cmd_install_db "$@" ;;
    update-db|updatedb)                  shift; cmd_install_db "$@" ;;
    remove-db|removedb)                  cmd_remove_db ;;
    db-info|dbinfo|info)                 cmd_db_info ;;
    version|-v|--version)                echo "kley v${KLEY_VERSION}" ;;
    help|-h|--help|halp)                 cmd_help ;;
    *)
        echo -e "${RED}❌ Unknown command: $1${RESET}" >&2
        echo -e "Type ${BLUE}kley help${RESET} for usage." >&2
        exit 1
        ;;
esac
